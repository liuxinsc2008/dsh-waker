{
  "name": "dsh-waker",
  "version": "0.2.0",
  "description": "跨会话往返：wake 把一条消息投给另一个会话、让它自己跑一轮；peek 读它回了什么。target 可直接填 session-id（直接用，不查表），也可填名字（查会话 id 字典解析）。纯 Host bundle，无 UI。",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "wake",
    "peek",
    "cross-session",
    "session",
    "multi-agent",
    "chat"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "USAGE.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --experimental-vm-modules _selftest.mjs && node --experimental-vm-modules _selftest_peek.mjs && node --experimental-vm-modules _selftest_sid.mjs && node --experimental-vm-modules _selftest_peek_sid.mjs",
    "check": "node --check lib/index.js && npm test",
    "prepack": "npm run check"
  },
  "meta": {
    "title": "唤醒器",
    "description": "跨会话往返：wake 把任务投给任意会话（填 id 或名字），peek 读它们回了什么。纯 Host bundle，无 UI。"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
